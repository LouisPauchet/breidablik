# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# A local `uv run` side effect, not an input to any build here: the Dockerfile, CI, and
# scripts/passenger_update.py all install from pyproject.toml (`uv pip install .` / `pip
# install -e .`), so a committed lockfile would drift unchecked rather than pin anything.
# If this ever moves to `uv sync --frozen`, commit it instead of ignoring it.
uv.lock

# Env
.env
.env.*
!.env.example

# Node / frontend build
frontend/node_modules/
frontend/.output/
frontend/.nuxt/
frontend/.data/
frontend/dist/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Alembic
app/alembic/versions/__pycache__/

# Misc
*.log
.cache/
*.sqlite3
/*.db

# Security audit inventory - contains live exploit details, never commit/push
/SECURITY_AUDIT.md

# User-uploaded profile pictures (local disk storage, see app/services/avatars.py) — must
# survive a Passenger code update untouched, so it's never part of the repo or a release.
/var/
/graphify-out/