# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
# Async SQLAlchemy URL. Postgres in production; sqlite+aiosqlite works for quick local trials.
DATABASE_URL=postgresql+asyncpg://breidablik:breidablik@localhost:5432/breidablik

# --- Security ---
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-to-a-long-random-string

# Household-wide timezone (IANA name). Every "what is today" calculation (duty rollover,
# reminders) uses this, not the host server's system timezone.
TIMEZONE=Europe/Paris

# --- Web Push (VAPID) ---
# Generate a keypair once, e.g.:
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys('/tmp/vapid'); print(open('/tmp/vapid_public_key.txt').read())"
# or via the `pywebpush`-adjacent `vapid` CLI. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@example.com

# --- Reminders / cron ---
# Shared secret required in the `X-Cron-Secret` header on POST /internal/cron/tick.
CRON_SECRET=change-me-too
# Only meaningful in Docker: runs an in-process APScheduler that calls the same reminder
# logic on a timer. Leave unset/false on Passenger shared hosting — use the host's own cron
# to hit /internal/cron/tick instead (Passenger may idle/recycle the worker process).
ENABLE_INTERNAL_SCHEDULER=true

# --- Passenger compatibility ---
# Only set this on shared hosting if the deploy fails and the Passenger error log shows it
# doesn't support ASGI natively (needed on Passenger < 6). Leave unset for Docker.
# PASSENGER_FORCE_WSGI=1

# --- Profile pictures ---
# Local-disk directory for uploaded avatars, deliberately outside the code tree so a Passenger
# code update (scripts/passenger_update.py) never touches it. Relative paths resolve against
# the process's working directory.
# AVATAR_STORAGE_DIR=var/avatars
# AVATAR_MAX_UPLOAD_BYTES=5242880
